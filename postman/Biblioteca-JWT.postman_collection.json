{
  "info": {
    "name": "Biblioteca - JWT y CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Crea una cuenta de demostración nueva; crea, actualiza y elimina solamente su libro de prueba. Conserva la cuenta. No contiene claves JWT ni credenciales de SQL. Cualquier cuenta registrada puede modificar libros en este alcance de demostración."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7149"
    },
    {
      "key": "demoEmail",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": "Biblioteca-Demo!2026"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    },
    {
      "key": "testIsbn",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Registrar usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"accessToken\");",
              "pm.collectionVariables.unset(\"bookId\");",
              "pm.collectionVariables.set(\"demoEmail\", \"lector.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");",
              "const prefix = \"978\" + String(Date.now()).slice(-9);",
              "let sum = 0;",
              "for (let i = 0; i < 12; i++) sum += Number(prefix[i]) * (i % 2 === 0 ? 1 : 3);",
              "pm.collectionVariables.set(\"testIsbn\", prefix + ((10 - sum % 10) % 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login y guardar JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              " const session = pm.response.json();",
              " pm.test(\"JWT y vencimiento\", function () { pm.expect(session.accessToken.split(\".\")).to.have.lengthOf(3); pm.expect(Date.parse(session.expiresAtUtc)).to.be.above(Date.now()); });",
              " pm.collectionVariables.set(\"accessToken\", session.accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear sin token debe fallar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Libro de prueba JWT\",\n  \"author\": \"Autor de prueba\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"publicationYear\": 2020\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Listar libros sin token",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Crear libro con JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Libro de prueba JWT\",\n  \"author\": \"Autor de prueba\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"publicationYear\": 2020\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const result = pm.response.json(); pm.test(\"Identificador generado\", function () { pm.expect(result.id).to.be.a(\"number\").and.above(0); }); pm.collectionVariables.set(\"bookId\", String(result.id)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Consultar libro creado",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.test(\"Datos guardados\", function () { pm.expect(pm.response.json().title).to.eql(\"Libro de prueba JWT\"); pm.expect(pm.response.json().isbn).to.eql(pm.collectionVariables.get(\"testIsbn\")); }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Actualizar con JWT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Libro actualizado con JWT\",\n  \"author\": \"Autor de prueba\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"publicationYear\": 2020\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Verificar actualizacion",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.test(\"Titulo actualizado\", function () { pm.expect(pm.response.json().title).to.eql(\"Libro actualizado con JWT\"); }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Rechazar titulo vacio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/books",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"author\": \"Autor de prueba\",\n  \"isbn\": \"{{testIsbn}}\",\n  \"publicationYear\": 2020\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Eliminar con JWT",
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Verificar eliminacion",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Rechazar password incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"Incorrecta!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ]
}
